ARG VLLM_BASE_IMAGE=vllm/vllm-openai@sha256:d9a5c1c1614c959fde8d2a4d68449db184572528a6055afdd0caf1e66fb51504
ARG DOCKER_CLI_IMAGE=docker:27-cli@sha256:851f91d241214e7c6db86513b270d58776379aacc5eb9c4a87e5b47115e3065c
FROM ${DOCKER_CLI_IMAGE} AS docker-cli

ARG VLLM_BASE_IMAGE
FROM ${VLLM_BASE_IMAGE}

WORKDIR /app

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

COPY pyproject.toml /app/pyproject.toml
COPY src /app/src

ENV HF_HOME=/var/lib/autonomousc/data/model-cache
ARG PRELOAD_HF_MODELS=
ENV AUTONOMOUSC_PRELOADED_HF_MODELS=${PRELOAD_HF_MODELS}

RUN mkdir -p /usr/local/libexec/docker/cli-plugins \
    && ln -sf /usr/bin/python3 /usr/local/bin/python \
    && python3 -m pip install --no-cache-dir --upgrade pip \
    && python3 -m pip install --no-cache-dir . \
    && python3 -m node_agent.cache_seed --cache-dir "$HF_HOME" --models "$AUTONOMOUSC_PRELOADED_HF_MODELS"

ENV AUTONOMOUSC_ALLOW_CONTAINER_BIND=true
ENV AUTONOMOUSC_RUNTIME_DIR=/var/lib/autonomousc
ENV INFERENCE_BASE_URL=http://127.0.0.1:8000
ENV VLLM_BASE_URL=http://127.0.0.1:8000
ENV VLLM_HOST=0.0.0.0
ENV VLLM_PORT=8000

EXPOSE 8765 8000

ENTRYPOINT ["node-agent-launcher"]
